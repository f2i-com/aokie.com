# Public deployment: copy to .env and replace every documentation value.
SIGNAL_HOST=signal.example.com
TURN_HOST=turn.example.com
TURN_REALM=turn.example.com
ACME_EMAIL=ops@example.com

# Public addresses routed to this Docker host. Set IPv6 only when AAAA,
# firewall, Docker IPv6 and one-to-one relay port routing are all configured.
TURN_EXTERNAL_IPV4=203.0.113.10
TURN_EXTERNAL_IPV6=
PUBLIC_IPV4=0.0.0.0
PUBLIC_IPV6=::

# A small explicit relay range makes firewalling and capacity visible. Increase
# it deliberately for expected concurrent allocations (roughly one port per
# allocation/component, with headroom).
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
TURN_USER_QUOTA=8
TURN_TOTAL_QUOTA=200
TURN_MAX_BPS=2000000
TURN_BPS_CAPACITY=100000000

# Change these only as an operator-controlled upgrade.
RUST_VERSION=1.92.0
AOKIE_IMAGE_TAG=local
AOKIE_IPV4_SUBNET=172.30.87.0/24
AOKIE_IPV6_SUBNET=fd87:a0c1:e000::/64
