{
  "contract": "transfer_v1",
  "kind": "ring_plan",
  "direction": "aokie_to_oaiy_host",
  "about": "Two plugin-to-host requests, sent over the plugin's stdio like flow.run. The host announces ringPlan in plugin.init.features when it answers them; without it the plugin never offers transfer. oaiy.ring.plan asks who may be rung and for how long (the host's ring policy decides; the plugin enforces the answer). oaiy.ring.opened tells the host the request is open so it can start delivery (desktop toast, ring items); nothing waits for its answer. A host that does not answer the plan within 1.5 s, or answers something unusable, means nobody is rung: the tool result is unavailable with reason plan_unavailable.",
  "planWaitMillis": 1500,
  "plan": {
    "method": "oaiy.ring.plan",
    "input": {
      "callId": "call_0123",
      "callEpoch": 7,
      "ownerEpoch": 4,
      "reason": "caller_asked",
      "callerNumber": "+61491570006",
      "recentCallerTurns": ["turn 0", "turn 1", "turn 2", "turn 3", "turn 4"]
    },
    "params": {
      "callId": "call_0123",
      "callEpoch": 7,
      "ownerEpoch": 4,
      "reason": "caller_asked",
      "callerNumber": "+61491570006",
      "recentCallerTurns": ["turn 2", "turn 3", "turn 4"]
    },
    "paramsRules": "At most the last three caller turns, each cut to 300 characters; callerNumber is left out when unknown. The turns never leave the machine: the host runs the phrase checks on them.",
    "results": [
      {
        "name": "ring the planned phone",
        "result": { "planId": "plan_0001", "decision": "ring", "reason": "ok", "ringSeconds": 40, "phones": ["thumb_phone_a"], "wake": ["thumb_phone_a"], "desktopToast": false, "desktopCompanions": [] },
