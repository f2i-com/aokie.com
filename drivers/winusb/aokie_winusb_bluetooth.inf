[Version]
Signature="$Windows NT$"
Class=USBDevice
ClassGuid={88BAE032-5A81-49f0-BC3D-A4FF138216D6}
Provider=%ProviderName%
DriverVer=07/15/2026,2.2.0.20260715
CatalogFile=aokie_winusb_bluetooth.cat

[ClassInstall32]
AddReg=AokieClassReg

[AokieClassReg]
HKR,,,0,"Universal Serial Bus devices"
HKR,,Icon,,-20

[Manufacturer]
%ProviderName%=AokieDevices,NTx86,NTamd64,NTarm64

[AokieDevices.NTx86]
%BCM21E8%=WinUSB_Install,USB\VID_0A5C&PID_21E8
%BCM21EC%=WinUSB_Install,USB\VID_0A5C&PID_21EC
