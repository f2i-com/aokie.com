%RTLC822%=WinUSB_Install,USB\VID_0BDA&PID_C822
%CSR0001%=WinUSB_Install,USB\VID_0A12&PID_0001

[AokieDevices.NTamd64]
%BCM21E8%=WinUSB_Install,USB\VID_0A5C&PID_21E8
%BCM21EC%=WinUSB_Install,USB\VID_0A5C&PID_21EC
%RTL8771%=WinUSB_Install,USB\VID_0BDA&PID_8771
%RTLC822%=WinUSB_Install,USB\VID_0BDA&PID_C822
%CSR0001%=WinUSB_Install,USB\VID_0A12&PID_0001

[AokieDevices.NTarm64]
%BCM21E8%=WinUSB_Install,USB\VID_0A5C&PID_21E8
%BCM21EC%=WinUSB_Install,USB\VID_0A5C&PID_21EC
