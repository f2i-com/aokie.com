<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Common-Controls v6 activation for TEST BINARIES ONLY (see build.rs).

  The linked Win32 surface imports comctl32's `TaskDialogIndirect`, which is
  exported by ComCtl32 v6 alone; System32's comctl32.dll is 5.82. `tauri_build`
  embeds this dependency into the app binary only, so an unmanifested test
  harness binds v5.82 and dies at load with STATUS_ENTRYPOINT_NOT_FOUND
  (0xC0000139) before a single test runs.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"
      />
    </dependentAssembly>
  </dependency>
</assembly>
